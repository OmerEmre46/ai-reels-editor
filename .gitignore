# --- Gizli bilgiler (API anahtarı) ---
.env
.env.*
!.env.example

# --- Python ---
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# --- Uygulama verisi: kullanıcıya ait ve yeniden üretilebilir ---
uploads/*
